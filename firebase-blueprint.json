    "FeedbackSuggestionRecord": {
      "title": "FeedbackSuggestionRecord",
      "description": "Represents a real-time feedback, suggestion, or appreciation message submitted by a Client or Healer to Healer Ddeepak Jain and the Master Admin dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderRole": {
          "type": "string",
          "enum": ["client", "healer", "admin"],
          "maxLength": 20
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "senderMobile": {
          "type": "string",
          "minLength": 7,
          "maxLength": 24
        },
        "senderEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["feedback", "suggestion", "appreciation", "support"],
          "maxLength": 30
        },
        "rating": {
          "type": "number"
        },
        "ratedHealerId": {
          "type": "string",
          "maxLength": 128
        },
        "ratedHealerName": {
          "type": "string",
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1500
        },
        "adminReply": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "accountId",
        "ownerUid",
        "senderRole",
        "senderName",
        "senderMobile",
        "senderEmail",
        "category",
        "rating",
        "message",
        "createdAtIso"
      ]
    },
    "BroadcastNotificationRecord": {
      "title": "BroadcastNotificationRecord",
      "description": "Represents a Master Admin live push notification, app update alert, or discount coupon announcement synced to all Client and Healer devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "category": {
          "type": "string",
          "enum": ["update", "offer", "muhurat", "announcement"],
          "maxLength": 30
        },
        "targetAudience": {
          "type": "string",
          "enum": ["all", "client", "healer"],
          "maxLength": 20
        },
        "couponCode": {
          "type": "string",
          "maxLength": 64
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "title",
        "message",
        "category",
        "targetAudience",
        "createdAtIso"
      ]
    }
  },
  "firestore": {
    "/tathastu_accounts/{accountId}": {
      "schema": {
        "$ref": "#/entities/AccountRecord"
      },
      "description": "Stores registered Client, Healer, and Admin account metadata synced in real time."
    },
    "/tathastu_profiles/{profileId}": {
      "schema": {
        "$ref": "#/entities/AstroProfileRecord"
      },
      "description": "Stores natal profiles (1+1 for Clients, up to plan limit for Healers, unlimited for Admin)."
    },
    "/tathastu_shared_reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/SharedReportRecord"
      },
      "description": "PII-isolated public report snapshot readable via single-document get by external mobile browsers opening shared report links or QR codes."
    },
    "/tathastu_feedbacks/{feedbackId}": {
      "schema": {
        "$ref": "#/entities/FeedbackSuggestionRecord"
      },
      "description": "Stores real-time Client and Healer feedbacks and suggestions synced to the Master Admin portal."
    },
    "/tathastu_broadcasts/{broadcastId}": {
      "schema": {
        "$ref": "#/entities/BroadcastNotificationRecord"
      },
      "description": "Stores Master Admin broadcast notifications and live app updates synced across mobile and desktop devices."
    }
  }
}
