{
  "entities": {
    "AccountRecord": {
      "title": "AccountRecord",
      "description": "Represents a registered Client, Healer, or Admin account in TATHASTU The Divine Light.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["client", "healer", "admin"],
          "maxLength": 20
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "mobile": {
          "type": "string",
          "minLength": 7,
          "maxLength": 24
        },
        "passwordHash": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "planId": {
          "type": "string",
          "maxLength": 64
        },
        "planName": {
          "type": "string",
          "maxLength": 100
        },
        "planPrice": {
          "type": "number"
        },
        "isFoc": {
          "type": "boolean"
        },
        "maxProfiles": {
          "type": "number"
        },
        "canDownloadShare": {
          "type": "boolean"
        },
        "subscriptionStart": {
          "type": "string",
          "maxLength": 40
        },
        "subscriptionExpiry": {
          "type": "string",
          "maxLength": 40
        },
        "healerBrandName": {
          "type": "string",
          "maxLength": 140
        },
        "healerLogoUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "healerInstagram": {
          "type": "string",
          "maxLength": 140
        },
        "healerFacebook": {
          "type": "string",
          "maxLength": 140
        },
        "healerYoutube": {
          "type": "string",
          "maxLength": 140
        },
        "healerWebsite": {
          "type": "string",
          "maxLength": 240
        },
        "healerAddress": {
          "type": "string",
          "maxLength": 300
        },
        "notificationPrefsJson": {
          "type": "string",
          "maxLength": 1000
        },
        "payuTransactionId": {
          "type": "string",
          "maxLength": 120
        },
        "payuUtrNumber": {
          "type": "string",
          "maxLength": 120
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "ownerUid",
        "role",
        "name",
        "email",
        "mobile",
        "passwordHash",
        "planId",
        "planName",
        "planPrice",
        "isFoc",
        "maxProfiles",
        "canDownloadShare",
        "subscriptionStart",
        "subscriptionExpiry",
        "createdAtIso"
      ]
    },
    "AstroProfileRecord": {
      "title": "AstroProfileRecord",
      "description": "Represents an individual natal/numerology profile belonging to a Client (Self or Family) or Healer's Client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerRole": {
          "type": "string",
          "enum": ["client", "healer", "admin"],
          "maxLength": 20
        },
        "relationTag": {
          "type": "string",
          "enum": ["self", "family", "healer-client"],
          "maxLength": 30
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dob": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "tob": {
          "type": "string",
          "maxLength": 20
        },
        "pob": {
          "type": "string",
          "maxLength": 160
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "mobile": {
          "type": "string",
          "minLength": 7,
          "maxLength": 24
        },
        "gender": {
          "type": "string",
          "maxLength": 20
        },
        "isLocked": {
          "type": "boolean"
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "notificationChannelsJson": {
          "type": "string",
          "maxLength": 1000
        },
        "partnerName": {
          "type": "string",
          "maxLength": 120
        },
        "partnerDob": {
          "type": "string",
          "maxLength": 20
        },
        "partnerTob": {
          "type": "string",
          "maxLength": 20
        },
        "partnerPob": {
          "type": "string",
          "maxLength": 160
        },
        "partnerLat": {
          "type": "number"
        },
        "partnerLng": {
          "type": "number"
        },
        "includePartnerMilan": {
          "type": "boolean"
        },
        "includeParivarMilan": {
          "type": "boolean"
        },
        "healthConcerns": {
          "type": "array",
          "description": "Bounded list of up to 10 selected health concern IDs for Yoga & Pranayama prescriptions."
        },
        "originalName": {
          "type": "string",
          "maxLength": 120
        },
        "selectedNameA": {
          "type": "string",
          "maxLength": 120
        },
        "selectedNameB": {
          "type": "string",
          "maxLength": 120
        },
        "originalMobile": {
          "type": "string",
          "maxLength": 24
        },
        "selectedMobileA": {
          "type": "string",
          "maxLength": 24
        },
        "selectedMobileB": {
          "type": "string",
          "maxLength": 24
        },
        "parivarMembers": {
          "type": "array",
          "description": "Bounded list of up to 5 family members for Parivar Milan 9-Chakra Diagnostics."
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "id",
        "accountId",
        "ownerUid",
        "ownerRole",
        "relationTag",
        "name",
        "dob",
        "tob",
        "pob",
        "lat",
        "lng",
        "email",
        "mobile",
        "gender",
        "isLocked",
        "notificationsEnabled",
        "createdAtIso"
      ]
    },
